{
  "schemaVersion": 1,
  "id": "speedrunnermod",
  "version": "${mod_version}+${mc_version}",
  "name": "The Speedrunner Mod",
  "description": "A Fabric mod that makes Minecraft speedrunning, easier.",
  "accessWidener": "speedrunnermod.accessWidener",
  "authors": [
    "Dillon8775",
    "MannyQUESO"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/speedrunner-mod",
    "sources": "https://github.com/Dillon8775/Speedrunner-Mod",
    "issues": "https://github.com/Dillon8775/Speedrunner-Mod/issues"
  },
  "license": "All Rights Reserved.",
  "icon": "assets/speedrunnermod/textures/gui/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.dillon.speedrunnermod.main.SpeedrunnerMod"
    ],
    "client": [
      "net.dillon.speedrunnermod.main.SpeedrunnerModClient"
    ],
    "fabric-datagen": [
      "net.dillon.speedrunnermod.data.generator.SpeedrunnerModDataGenerator"
    ],
    "modmenu": [
      "net.dillon.speedrunnermod.impl.ModMenuImpl"
    ]
  },
  "mixins": [
    "speedrunnermod.mixins.json",
    {
      "config": "speedrunnermod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": "*",
    "minecraft": ">=26.2-rc.1",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/vfqEAn4YFy"
      }
    }
  }
}