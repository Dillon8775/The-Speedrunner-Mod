{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}+${mc_version}",
  "name": "The Speedrunner Mod",
  "description": "A Fabric mod that makes Minecraft speedrunning, easier.",
  "accessWidener": "speedrunnermod.accessWidener",
  "authors": [
    "Dillon8775",
    "MannyQUESO"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/speedrunner-mod",
    "sources": "https://github.com/Dillon8775/Speedrunner-Mod",
    "issues": "https://github.com/Dillon8775/Speedrunner-Mod/issues"
  },
  "license": "All Rights Reserved.",
  "icon": "assets/speedrunnermod/textures/gui/sprites/hud/logo_smithing_template.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.dillon.speedrunnermod.main.CommonMain"
    ],
    "client": [
      "net.dillon.speedrunnermod.main.ClientMain"
    ],
    "fabric-datagen": [
      "net.dillon.speedrunnermod.data.SpeedrunnerModDataGenerator"
    ],
    "modmenu": [
      "net.dillon.speedrunnermod.impl.ModMenuImpl"
    ]
  },
  "mixins": [
    "speedrunnermod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}",
    "dillonlib": ">=${dillonlib_version}",
    "balm-fabric": ">=${balm_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/vfqEAn4YFy"
      }
    }
  }
}